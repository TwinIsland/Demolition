{
  "name": "demolition-front",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:game && npm run build:wiki",
    "build:pages": "npm run build:game -- --outDir .pages-build --emptyOutDir && vitepress build docs --base /Demolition/wiki/ --outDir .pages-build/wiki",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "build:game": "tsc --noEmit && vite build",
    "dev:wiki": "vitepress dev docs",
    "build:wiki": "vitepress build docs --outDir dist/wiki"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "kaplay": "^3001.0.19",
    "motion": "^14.14.0",
    "n8ao": "^2.1.0",
    "postprocessing": "^6.39.6",
    "skinview-utils": "^0.7.1",
    "skinview3d": "^3.4.2",
    "three": "^0.181.2",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.19.0",
    "@types/three": "^0.181.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.2.2",
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "skinview3d": {
      "three": "$three",
      "@types/three": "$@types/three"
    }
  },
  "imports": {
    "#game-catalog": {
      "types": "./src/modules/catalog.browser.ts",
      "browser": "./src/modules/catalog.browser.ts",
      "default": "./src/modules/catalog.node.ts"
    }
  }
}
